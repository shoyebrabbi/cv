rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'md.shoyeb.rabbi@gmail.com';
    }

    function isValidPublicSite(data) {
      return data.keys().hasAll(['activeProfileId', 'activeData', 'activeSettings', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['activeProfileId', 'activeData', 'activeSettings', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.activeProfileId is string
        && data.activeProfileId.size() > 0
        && data.activeProfileId.size() <= 80
        && data.activeProfileId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.activeData is map
        && data.activeData.name is string
        && data.activeData.name.size() <= 140
        && data.activeData.title is string
        && data.activeData.title.size() <= 240
        && data.activeSettings is map
        && data.ownerUid is string
        && data.ownerUid.size() <= 128
        && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'rolePreset', 'isPublished', 'sortOrder', 'data', 'settings', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'description', 'rolePreset', 'isPublished', 'sortOrder', 'data', 'settings', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 320
        && data.rolePreset is string
        && data.rolePreset in ['master', 'data', 'sqa', 'netops', 'custom']
        && data.isPublished is bool
        && data.sortOrder is number
        && data.data is map
        && data.settings is map
        && data.ownerUid is string
        && data.ownerUid.size() <= 128
        && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJobApp(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'company', 'role', 'status', 'appliedDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'company', 'role', 'profileName', 'url', 'notes', 'status', 'appliedDate', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerUid is string
        && data.ownerUid.size() <= 128
        && data.ownerUid == request.auth.uid
        && data.company is string
        && data.company.size() > 0
        && data.company.size() <= 140
        && data.role is string
        && data.role.size() > 0
        && data.role.size() <= 140
        && (!('profileName' in data) || (data.profileName is string && data.profileName.size() <= 120))
        && (!('url' in data) || (data.url is string && data.url.size() <= 400))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1500))
        && data.status is string
        && data.status in ['Applied', 'Shortlisted', 'Technical Test', 'Interview', 'Offer', 'Rejected']
        && data.appliedDate is string
        && data.appliedDate.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomTemplate(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'description', 'settingsSnapshot', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'description', 'settingsSnapshot', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerUid is string
        && data.ownerUid.size() <= 128
        && data.ownerUid == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 240
        && data.settingsSnapshot is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicInquiry(data) {
      return data.keys().hasAll(['id', 'senderName', 'senderEmail', 'subject', 'message', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['id', 'senderName', 'senderEmail', 'subject', 'message', 'targetRole', 'isRead', 'createdAt'])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 80
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.senderName is string
        && data.senderName.size() > 0
        && data.senderName.size() <= 120
        && data.senderEmail is string
        && data.senderEmail.size() > 0
        && data.senderEmail.size() <= 160
        && data.subject is string
        && data.subject.size() > 0
        && data.subject.size() <= 160
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 3000
        && (!('targetRole' in data) || (data.targetRole is string && data.targetRole.size() <= 120))
        && data.isRead is bool
        && data.createdAt is timestamp;
    }

    function isValidPublicAnalytics(data) {
      return data.keys().hasAll(['totalViews', 'pdfDownloads', 'roleClicks', 'lastVisitedAt'])
        && data.keys().hasOnly(['totalViews', 'pdfDownloads', 'roleClicks', 'lastVisitedAt'])
        && data.totalViews is number
        && data.totalViews >= 0
        && data.pdfDownloads is number
        && data.pdfDownloads >= 0
        && data.roleClicks is map
        && data.roleClicks.size() <= 30
        && data.lastVisitedAt is timestamp;
    }

    // 1. Published live website & default CV document (public get, admin-only write)
    match /public_site/{siteId} {
      allow get: if isValidId(siteId) && siteId == 'main';
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(siteId)
        && siteId == 'main'
        && isValidPublicSite(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(siteId)
        && siteId == 'main'
        && isValidPublicSite(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['activeProfileId', 'activeData', 'activeSettings', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Role-tailored profiles for ?role= recruiter lenses (public published read, admin write)
    match /public_profiles/{profileId} {
      allow get: if isValidId(profileId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(profileId)
        && isValidPublicProfile(incoming())
        && incoming().id == profileId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(profileId)
        && isValidPublicProfile(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'rolePreset', 'isPublished', 'sortOrder', 'data', 'settings', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(profileId) && profileId != 'prof_master';
    }

    // 3. Owner-private workspace (Job Tracker & Custom Templates)
    match /owner_workspaces/{ownerId}/job_applications/{appId} {
      allow get: if isAdmin()
        && isValidId(ownerId)
        && isValidId(appId)
        && request.auth.uid == ownerId
        && existing().ownerUid == request.auth.uid;
      allow list: if isAdmin()
        && isValidId(ownerId)
        && request.auth.uid == ownerId
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isAdmin()
        && isValidId(ownerId)
        && isValidId(appId)
        && request.auth.uid == ownerId
        && isValidJobApp(incoming())
        && incoming().id == appId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(ownerId)
        && isValidId(appId)
        && request.auth.uid == ownerId
        && existing().ownerUid == request.auth.uid
        && isValidJobApp(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['company', 'role', 'profileName', 'url', 'notes', 'status', 'appliedDate', 'updatedAt']);
      allow delete: if isAdmin()
        && isValidId(ownerId)
        && isValidId(appId)
        && request.auth.uid == ownerId
        && existing().ownerUid == request.auth.uid;
    }

    match /owner_workspaces/{ownerId}/custom_templates/{tplId} {
      allow get: if isAdmin()
        && isValidId(ownerId)
        && isValidId(tplId)
        && request.auth.uid == ownerId
        && existing().ownerUid == request.auth.uid;
      allow list: if isAdmin()
        && isValidId(ownerId)
        && request.auth.uid == ownerId
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isAdmin()
        && isValidId(ownerId)
        && isValidId(tplId)
        && request.auth.uid == ownerId
        && isValidCustomTemplate(incoming())
        && incoming().id == tplId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(ownerId)
        && isValidId(tplId)
        && request.auth.uid == ownerId
        && existing().ownerUid == request.auth.uid
        && isValidCustomTemplate(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'settingsSnapshot', 'updatedAt']);
      allow delete: if isAdmin()
        && isValidId(ownerId)
        && isValidId(tplId)
        && request.auth.uid == ownerId
        && existing().ownerUid == request.auth.uid;
    }

    // 4. Admin role verification marker (read own marker only, no client writes)
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // 5. Public visitor contact inquiries (public create-only inbox; strictly admin read/manage)
    match /public_inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidPublicInquiry(incoming())
        && incoming().id == inquiryId
        && incoming().isRead == false
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidPublicInquiry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
        && incoming().isRead is bool;
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    // 6. Aggregate cross-device portfolio analytics (public counter write-increment, admin read)
    match /public_analytics/{docId} {
      allow get: if isAdmin() && isValidId(docId) && docId == 'main';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'main'
        && isValidPublicAnalytics(incoming())
        && incoming().totalViews <= 1
        && incoming().pdfDownloads <= 1
        && incoming().lastVisitedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'main'
        && isValidPublicAnalytics(incoming())
        && incoming().totalViews >= existing().totalViews
        && incoming().totalViews <= existing().totalViews + 1
        && incoming().pdfDownloads >= existing().pdfDownloads
        && incoming().pdfDownloads <= existing().pdfDownloads + 1
        && incoming().lastVisitedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['totalViews', 'pdfDownloads', 'roleClicks', 'lastVisitedAt']);
      allow delete: if false;
    }
  }
}
